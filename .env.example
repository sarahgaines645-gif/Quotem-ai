# Q's runtime environment.
# Copy this file to `.env` for local dev, or set these in Railway's
# variables panel for production. Never commit `.env`.

# ─── Required ───────────────────────────────────────────────────
# Together AI key — Q's main brain (DeepSeek V4 Pro for chat / agent /
# code / etc., plus Qwen3.5-9B for vision). Get one at together.ai.
TOGETHER_API_KEY=

# ─── Optional skills ────────────────────────────────────────────
# Each of these points at a Hugging Face Space that Q calls for the
# corresponding skill. If unset, the skill stays disabled and Q's UI
# shows a friendly "not configured" message. Set up the Spaces from
# the *-space folders in this repo when you want the skill live.

# CHATTERBOX_SPACE_URL (voice cloning) and ACESTEP_SPACE_URL (music) were
# RETIRED 2026-08-15 — no longer read. See retired/2026-08-15-voice-clone-and-music/RETIRED.md

# Image generation (Z-Image).
ZIMAGE_SPACE_URL=

# Image-to-SVG (StarVector).
STARVECTOR_SPACE_URL=

# Video generation (Wan 2.2).
WAN_SPACE_URL=

# ─── Web search (optional) ──────────────────────────────────────
# SerpAPI key for Q's agent skill. If unset, agent runs without web.
SERP_API_KEY=

# ─── Travel search (optional) ───────────────────────────────────
# ONE RapidAPI key powers all three travel tools (search_hotels,
# search_flights, flight_schedule) in plugins/q-travel.js. Until this
# is set, every travel tool returns a friendly "not switched on yet"
# and Q says so plainly — nothing crashes, nothing is invented.
# Each supplier still needs its own subscription on the same RapidAPI
# account: booking-com15 (hotels), sky-scrapper (flight prices) and
# aerodatabox (route days-of-week).
RAPIDAPI_KEY=

# Optional host overrides — only set these if a supplier changes.
# RAPIDAPI_HOTELS_HOST=booking-com15.p.rapidapi.com
# RAPIDAPI_FLIGHTS_HOST=sky-scrapper.p.rapidapi.com
# RAPIDAPI_SCHEDULE_HOST=aerodatabox.p.rapidapi.com

# Which flight-price supplier the adapter uses: skyscanner (default)
# or booking (reuses the hotel subscription, no extra sign-up).
# TRAVEL_FLIGHT_PROVIDER=skyscanner

# ─── Auth / Circle Mode ─────────────────────────────────────────
# Q_AUTH_PEPPER signs every session cookie. Generate a long random string
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# and NEVER change it after Q has registered users — every session dies.
# REQUIRED in production (>=16 chars): the server REFUSES TO BOOT without
# it (server/index.js). Local dev without it gets a random per-process
# key and a warning.
Q_AUTH_PEPPER=

# EMAIL_TOKEN_KEY encrypts connected-mailbox credentials (Gmail/Outlook
# refresh tokens, SMTP app passwords) at rest — plugins/q-email-accounts.js.
# REQUIRED in production (>=16 chars): the server REFUSES TO BOOT without it.
# ⚠️ If this var has NEVER been set on Railway, existing mailboxes were
# encrypted with Q_AUTH_PEPPER (the old fallback). Set EMAIL_TOKEN_KEY to
# the SAME value as Q_AUTH_PEPPER to keep them readable; any other value
# means every user has to reconnect their mailbox. Never rotate afterwards.
EMAIL_TOKEN_KEY=

# ─── Sign-up verification email (IONOS SMTP) ────────────────────
# Sign-up now emails a verification link (mailer.js). Same creds as the
# password-reset email. PASS = an IONOS App Password, not the mailbox one.
# If unset, sign-ups still land as pending and Sarah's approval on the
# members page also marks the email verified.
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Google Maps / Street View (optional) ───────────────────────
# One Maps Platform key serves the street_view tool. GOOGLE_MAPS_KEY is
# preferred; GOOGLE_PLACES_KEY is accepted as an alias (the Railway env
# historically carried that name — DEV_QUEUE #9).
GOOGLE_MAPS_KEY=
# GOOGLE_PLACES_KEY=

# ─── Brand logos on the finance page (optional) ─────────────────
# plugins/q-logos.js. Without a key, small brand marks come from Google's
# favicon service, fetched ONCE per brand by Q's server and cached on disk
# (data/logo-cache or the Railway volume) — the browser never talks to a
# logo host. Set a Logo.dev publishable key (pk_...) for crisper logos.
# Free tier requires a "Logos provided by Logo.dev" credit on the page.
# LOGO_DEV_KEY=

# ─── Railway-set automatically ──────────────────────────────────
# RAILWAY_VOLUME_MOUNT_PATH — set by Railway when a volume is attached.
# Q stores his persistent memory + people registry under this path.
# Don't set manually unless you're testing volume behaviour locally.
